APP_NAME=FXV BPMN
ENV=development
LOG_LEVEL=INFO
OUTPUT_FOLDER=app/generated

# LLM — auto picks first available provider; or set ollama|omniroute|openrouter|openai|gemini
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Leave keys empty unless you use that provider
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=auto
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=auto

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
CHAT_RATE_LIMIT=8
CHAT_RATE_WINDOW_S=60
PROMPT_MAX_CHARS=4000
TRUST_PROXY=false

# Camunda 8 Run (c8run) — keep false until c8run is up on :8080
CAMUNDA_BASE_URL=http://127.0.0.1:8080
CAMUNDA_DEPLOY_ENABLED=false
CAMUNDA_TOKEN=

# Optional overrides (defaults resolve relative to backend/)
EXAMPLES_DIR=
CATALOG_PATH=
