<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_employee_onboarding" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="employee_onboarding" name="Employee Onboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_employee_onboarding">
      <bpmn:lane id="admin" name="Admin Staff">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>create_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="general" name="General">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="verify" name="Verify Employee">
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approve" name="Manager Approval">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition candidateGroups="admin"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="create_account" name="Create Account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fxv.employee_onboarding.create_account"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="verify"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="verify" targetRef="approve"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="approve" targetRef="create_account"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="create_account" targetRef="end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_employee_onboarding">
    <bpmndi:BPMNPlane id="BPMNPlane_employee_onboarding" bpmnElement="employee_onboarding">
      <bpmndi:BPMNShape id="admin_di" bpmnElement="admin" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="1300" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="system_di" bpmnElement="system" isHorizontal="true">
        <dc:Bounds x="60" y="240" width="1300" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="general_di" bpmnElement="general" isHorizontal="true">
        <dc:Bounds x="60" y="400" width="1300" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="462" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_di" bpmnElement="verify">
        <dc:Bounds x="400" y="440" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="620" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="create_account_di" bpmnElement="create_account">
        <dc:Bounds x="840" y="280" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1060" y="302" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="480"/>
        <di:waypoint x="400" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="500" y="480"/>
        <di:waypoint x="620" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="720" y="160"/>
        <di:waypoint x="840" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="940" y="320"/>
        <di:waypoint x="1060" y="320"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
