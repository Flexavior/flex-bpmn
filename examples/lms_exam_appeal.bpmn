<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_lms_exam_appeal" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="lms_exam_appeal" name="Exam Incident and Appeal" isExecutable="true">
    <bpmn:laneSet id="LaneSet_lms_exam_appeal">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file_appeal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teacher" name="Teacher">
        <bpmn:flowNodeRef>teacher_regrade</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admin" name="Admin Staff">
        <bpmn:flowNodeRef>staff_triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_outcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>reject_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="file_appeal" name="Student files appeal">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition candidateGroups="student"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="staff_triage" name="Staff triage appeal">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition candidateGroups="admin"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="valid_gw" name="Valid appeal?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reject_appeal" name="Reject invalid appeal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fxv.lms_exam_appeal.reject_appeal"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_rejected" name="Rejected">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="teacher_regrade" name="Teacher regrades">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition candidateGroups="teacher"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="record_outcome" name="Staff record outcome">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition candidateGroups="admin"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="notify_student" name="Notify student">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fxv.lms_exam_appeal.notify_student"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_resolved" name="Resolved">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="file_appeal"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="file_appeal" targetRef="staff_triage"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="staff_triage" targetRef="valid_gw"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="valid_gw" targetRef="reject_appeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= valid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="valid_gw" targetRef="teacher_regrade"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="reject_appeal" targetRef="end_rejected"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="teacher_regrade" targetRef="record_outcome"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="record_outcome" targetRef="notify_student"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="notify_student" targetRef="end_resolved"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_lms_exam_appeal">
    <bpmndi:BPMNPlane id="BPMNPlane_lms_exam_appeal" bpmnElement="lms_exam_appeal">
      <bpmndi:BPMNShape id="student_di" bpmnElement="student" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="1960" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="teacher_di" bpmnElement="teacher" isHorizontal="true">
        <dc:Bounds x="60" y="240" width="1960" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="admin_di" bpmnElement="admin" isHorizontal="true">
        <dc:Bounds x="60" y="400" width="1960" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="system_di" bpmnElement="system" isHorizontal="true">
        <dc:Bounds x="60" y="560" width="1960" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="file_appeal_di" bpmnElement="file_appeal">
        <dc:Bounds x="400" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="staff_triage_di" bpmnElement="staff_triage">
        <dc:Bounds x="620" y="440" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="valid_gw_di" bpmnElement="valid_gw">
        <dc:Bounds x="840" y="455" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reject_appeal_di" bpmnElement="reject_appeal">
        <dc:Bounds x="1060" y="600" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected">
        <dc:Bounds x="1280" y="622" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="teacher_regrade_di" bpmnElement="teacher_regrade">
        <dc:Bounds x="1060" y="280" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="record_outcome_di" bpmnElement="record_outcome">
        <dc:Bounds x="1280" y="440" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_student_di" bpmnElement="notify_student">
        <dc:Bounds x="1500" y="600" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_resolved_di" bpmnElement="end_resolved">
        <dc:Bounds x="1720" y="622" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="160"/>
        <di:waypoint x="400" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="500" y="160"/>
        <di:waypoint x="620" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="720" y="480"/>
        <di:waypoint x="840" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="890" y="480"/>
        <di:waypoint x="1060" y="640"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="890" y="480"/>
        <di:waypoint x="1060" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1160" y="640"/>
        <di:waypoint x="1280" y="640"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1160" y="320"/>
        <di:waypoint x="1280" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1380" y="480"/>
        <di:waypoint x="1500" y="640"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1600" y="640"/>
        <di:waypoint x="1720" y="640"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
